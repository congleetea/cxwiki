# Generated HTML and copied assets. Rebuild with:
# python scripts/build_blog.py
/site/public/
/index.html
/wiki/index.html
/wiki/series/

# Python bytecode, test caches, and local virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/
.cache/
.ipynb_checkpoints/
.venv/
venv/

# Browser testing artifacts (not the test scripts themselves)
/site/test-results/
/site/playwright-report/
/site/blob-report/

# Local secrets and machine-specific settings
.env
.env.*
!.env.example
/.vscode/
/.idea/
/.obsidian/
.netrc
*.netrc
.htpasswd
*.htpasswd
/site/deploy/**/*.key
/site/deploy/**/*.pem
/site/deploy/**/*.crt
/site/deploy/**/*.p12
/site/deploy/**/*.pfx

# OS metadata, editor backups, and incomplete downloads
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.part
*.crdownload
*.tmp
*.temp
*.bak
/*.log
/site/deploy/*.log

# Keep wiki Markdown, raw evidence/PDFs, figures,
# site source/vendor assets, skills, and documentation under version control.

# Redundant landing page and local implementation plans
/README.html
/docs/

# Code checkouts are local-only; retain the directory placeholder.
/raw/codes/*
!/raw/codes/.gitkeep
